#!/usr/bin/env python3
"""
Skeleton of the Pi-side conversion relay.

Polls the DB for jobs in 'pending-conversion' status, ships the Office file
to the iMac's watched inbox, waits for the PDF to appear in the outbox,
pulls it back, and submits to CUPS.

This will become a systemd timer/service on the Pi when the iMac arrives.
For now it's a reference — NOT wired into the running system.
"""
from __future__ import annotations

import logging
import os
import shutil
import subprocess
import time
from pathlib import Path

log = logging.getLogger("conversion-relay")

# --- config (set when the iMac is up) ---
IMAC_HOST = "10.0.0.X"            # iMac's IP on the school LAN
IMAC_USER = "kenny_lhs"
IMAC_SHARE = "/Users/Shared/SchoolPrinter"
INBOX = f"{IMAC_SHARE}/inbox"
OUTBOX = f"{IMAC_SHARE}/outbox"
POLL_INTERVAL = 15                 # seconds between DB scans
CONVERSION_TIMEOUT = 180           # give the iMac 3 minutes per file


def push_to_imac(local_path: str, remote_name: str) -> None:
    """scp the Office file to the iMac's inbox."""
    dst = f"{IMAC_USER}@{IMAC_HOST}:{INBOX}/{remote_name}"
    log.info("pushing %s -> %s", local_path, dst)
    subprocess.run(["scp", "-B", local_path, dst], check=True, timeout=60)


def pull_from_imac(remote_pdf: str, local_pdf: str) -> bool:
    """Poll the iMac outbox for the converted PDF; return True when pulled."""
    deadline = time.time() + CONVERSION_TIMEOUT
    while time.time() < deadline:
        rc = subprocess.run(
            ["scp", "-B", f"{IMAC_USER}@{IMAC_HOST}:{remote_pdf}", local_pdf],
            capture_output=True, timeout=30,
        ).returncode
        if rc == 0:
            return True
        time.sleep(10)
    return False


def main() -> None:
    # NOTE: this is illustrative; we'll finish it when the iMac arrives.
    raise SystemExit(
        "Pi-side conversion relay is not yet active. "
        "Wire this up once the iMac is connected."
    )


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    main()
