#!/bin/bash
# Run on YOUR Mac. Controls the iMac's AirPrint service over ssh. Works whether
# the iMac runs Linux (the /usr/local/bin/school-print it installs) or the old
# macOS setup; it asks the machine which it is.
#
#   school-print status                 service, open printer, pending requests
#   school-print requests               pending student requests
#   school-print list                   every request and its state
#   school-print approve <id>           approve a request (see `requests` for the id) and
#                                       sign its Shortcut; `shortcut <id>` retries the signing
#   school-print revoke <id>            cut off one device
#   school-print on | off               the open "School Print" printer anyone on the
#                                       Wi-Fi can see; prints as the `owner` account
#   school-print owner [school-id]      show / set that account
#   school-print stop | start           the whole service, including every student's printer
#   school-print host [user@address]    show / save which machine to control
#
# Students' printers (installed from a profile) work whenever the service runs.
# Only the open printer is a switch: it is off unless you turn it on.
#
# Which machine: $SCHOOL_PRINT_HOST, else the one saved with `school-print host`,
# else imac.local if it answers, else the old address. imac.local is Bonjour and
# does not cross subnets, so a saved address is more reliable away from the dorm.
# Linux needs the sudoers line in deploy/linux/sudoers-school-print.example.
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/school-print/host
REMOTE_TOOL=${SCHOOL_PRINT_REMOTE:-/usr/local/bin/school-print}

if [[ ${1:-} == host ]]; then
  if [[ -n ${2:-} ]]; then
    [[ $2 =~ ^[A-Za-z0-9._@-]+$ ]] || { echo "invalid host"; exit 2; }
    mkdir -p "$(dirname "$CONF")" && echo "$2" > "$CONF"
  fi
  echo "Controlling: ${SCHOOL_PRINT_HOST:-$(cat "$CONF" 2>/dev/null || echo '(auto: imac.local, else kenny_lhs@10.2.187.53)')}"
  exit 0
fi

IMAC=${SCHOOL_PRINT_HOST:-$(cat "$CONF" 2>/dev/null)}
IMAC=${IMAC:-$(ping -c1 -t2 imac.local >/dev/null 2>&1 && echo imac.local || echo kenny_lhs@10.2.187.53)}
run() { ssh -o BatchMode=yes -o ConnectTimeout=6 "$IMAC" "$@"; }

OS=$(run uname -s 2>/dev/null | tr -d '[:space:]')
[[ -n $OS ]] || { echo "iMac unreachable"; exit 1; }

need_id() { [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "usage: school-print $1 <id>"; exit 2; }; }
need_owner() { [[ ${1:-} =~ ^[A-Za-z0-9._-]{2,64}$ ]] || { echo "invalid account name"; exit 1; }; }

# Signing a Shortcut uploads it to iCloud, which fails from the iMac's network
# (and a Linux box has no `shortcuts`), so it is signed here and the signed file
# is stored on the iMac for the relay to serve.
sign_here() { # in out
  local n
  for n in 1 2 3; do
    shortcuts sign --mode anyone --input "$1" --output "$2" >/dev/null 2>&1 && return 0
    sleep "${SIGN_RETRY_DELAY:-2}"
  done
  return 1
}

# ============================== Linux ==============================
L() { run "$REMOTE_TOOL" "$@"; }

linux_shortcut() {
  local id=$1 d url
  d=$(mktemp -d) || return 1
  url="http://$(L address | tr -d '[:space:]'):8000/print"
  L unsigned "$id" "$url" > "$d/in.shortcut" 2>/dev/null || { echo "could not export shortcut"; rm -rf "$d"; return 1; }
  if sign_here "$d/in.shortcut" "$d/out.shortcut" && L store-shortcut "$id" < "$d/out.shortcut" >/dev/null; then
    echo "Shortcut signed and stored for request $id"; rm -rf "$d"; return 0
  fi
  echo "Shortcut NOT signed or stored (iCloud unreachable?). The profile still works; retry: school-print shortcut $id"
  rm -rf "$d"; return 1
}

linux_main() {
  local out rc
  case ${1:-status} in
    status) L summary ;;
    requests|list) L "$1"; return ;;
    approve) need_id "$@"; L approve "$2" && linux_shortcut "$2"; return ;;
    shortcut) need_id "$@"; linux_shortcut "$2"; return ;;
    revoke) need_id "$@"; L revoke "$2"; return ;;
    on|off|start|stop) L "$1" && sleep 2 && L summary ;;
    owner)
      if [[ -n ${2:-} ]]; then need_owner "$2"; L owner "$2" >/dev/null; fi
      echo "Open printer prints as: $(L owner 2>/dev/null)"; return ;;
    *) sed -n 2,19p "$0" | sed 's/^# \{0,1\}//'; return 2 ;;
  esac
}

# ============================== macOS (the old setup) ==============================
LABEL=com.school.airprint
SHIM='$HOME/school-printer/airprint-shim'
cli() {
  run "cd \$HOME/school-printer/server && SP_BASE_DIR=\$HOME/school-printer SP_DATA_DIR=\$HOME/school-printer/data SP_SPOOL_DIR=\$HOME/school-printer/spool SP_DB_PATH=\$HOME/school-printer/data/printers.db ../venv/bin/python -m app.airprint_cli $*"
}
mac_service_up() { run "launchctl print gui/\$(id -u)/$LABEL >/dev/null 2>&1 && echo up || echo down" 2>/dev/null || echo unreachable; }
mac_wait_ready() {
  run "for _ in \$(seq 1 30); do ipptool -q ipp://localhost:8631/ipp/print /usr/share/cups/ipptool/get-printer-attributes.test >/dev/null 2>&1 && break; sleep 1; done" >/dev/null 2>&1
}
mac_start() {
  run "launchctl enable gui/\$(id -u)/$LABEL; launchctl bootstrap gui/\$(id -u) \$HOME/Library/LaunchAgents/$LABEL.plist 2>/dev/null; launchctl kickstart gui/\$(id -u)/$LABEL" >/dev/null 2>&1
  mac_wait_ready
}
mac_status() {
  local s open owner pend; s=$(mac_service_up)
  [[ $s == unreachable ]] && { echo "iMac unreachable"; exit 1; }
  open=$(run "test -f $SHIM/bonjour.on && echo ON || echo OFF")
  owner=$(run "cat $SHIM/owner 2>/dev/null")
  pend=$(cli list pending | tail -n +2 | grep -c . || true)
  echo "Service: $([[ $s == up ]] && echo RUNNING || echo STOPPED) | Open printer: $open (as ${owner:-nobody}) | Pending requests: $pend"
}
mac_shortcut() {
  local id=$1 d url
  d=$(mktemp -d) || return 1
  url="http://$(run 'ipconfig getifaddr en1' | tr -d '[:space:]'):8000/print"
  cli unsigned "$id" "$url" > "$d/in.shortcut" 2>/dev/null || { echo "could not export shortcut"; rm -rf "$d"; return 1; }
  if sign_here "$d/in.shortcut" "$d/out.shortcut" && run 'mkdir -p $HOME/school-printer/data/shortcuts' \
      && scp -q -o BatchMode=yes "$d/out.shortcut" "$IMAC:school-printer/data/shortcuts/$id.shortcut"; then
    echo "Shortcut signed and stored for request $id"; rm -rf "$d"; return 0
  fi
  echo "Shortcut NOT signed (iCloud unreachable?). The profile still works; retry: school-print shortcut $id"
  rm -rf "$d"; return 1
}
mac_main() {
  case ${1:-status} in
    status) mac_status ;;
    requests) cli list pending; return ;;
    list) cli list; return ;;
    approve) need_id "$@"; cli approve "$2" && mac_shortcut "$2"; return ;;
    shortcut) need_id "$@"; mac_shortcut "$2"; return ;;
    revoke) need_id "$@"; cli revoke "$2"; return ;;
    on) [[ $(mac_service_up) == up ]] || mac_start; run "touch $SHIM/bonjour.on"; sleep 4; mac_status ;;
    off) run "rm -f $SHIM/bonjour.on"; sleep 3; mac_status ;;
    start) mac_start; mac_status ;;
    stop) run "launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null; launchctl disable gui/\$(id -u)/$LABEL" >/dev/null 2>&1; sleep 2; mac_status ;;
    owner)
      if [[ -n ${2:-} ]]; then need_owner "$2"; run "echo '$2' > $SHIM/owner"; fi
      echo "Open printer prints as: $(run "cat $SHIM/owner" 2>/dev/null)"; return ;;
    *) sed -n 2,19p "$0" | sed 's/^# \{0,1\}//'; return 2 ;;
  esac
}

if [[ $OS == Linux ]]; then linux_main "$@"; else mac_main "$@"; fi
