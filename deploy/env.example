# School Printer Relay configuration.
# Copy to .env on the Pi. The systemd unit reads this via EnvironmentFile.

# ---- Admin bootstrap (first run only) ----
# Set this to a strong password before first start. The server will create
# the admin account on boot, then you can blank this out.
SP_BOOTSTRAP_ADMIN_USER=admin
SP_BOOTSTRAP_ADMIN_PASS=change-me-on-first-boot

# ---- JWT ----
# Leave blank -> auto-generated and stored in data_dir/secret_key
SP_SECRET_KEY=

# ---- CUPS ----
SP_CUPS_QUEUE=bw

# ---- Uploads ----
SP_MAX_UPLOAD_MB=50
