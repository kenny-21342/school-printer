# School Printer Relay configuration.
#
# Copy to /opt/school-printer/.env on the Pi (NOT into server/ — that directory
# is rsync'd with --delete on every deploy). The systemd unit reads this via
# EnvironmentFile=-/opt/school-printer/.env
#
# chmod 600 this file: it holds the admin bootstrap password.

# ---- Admin bootstrap (first run only) ----
# Set this to a strong password before first start. The server will create
# the admin account on boot, then you can blank this out.
SP_BOOTSTRAP_ADMIN_USER=admin
SP_BOOTSTRAP_ADMIN_PASS=change-me-on-first-boot

# ---- JWT ----
# Leave blank -> auto-generated and stored in data_dir/secret_key
SP_SECRET_KEY=

# ---- CUPS ----
SP_CUPS_QUEUE=bw

# ---- Uploads ----
# Keep in sync with the default in server/app/config.py.
SP_MAX_UPLOAD_MB=50

# ---- Spool retention ----
# Uploaded files are deleted this many hours after the job reaches a terminal
# state. Without this the Pi's SD card fills up. 0 disables the reaper.
SP_SPOOL_RETENTION_HOURS=24
