# School Printer Relay configuration.
#
# Copy to /usr/local/school-printer/.env on the iMac (NOT into server/ — that
# directory is rsync'd with --delete on every deploy). deploy-macos.sh creates
# it from this file on first install and never touches it again.
#
# The LaunchAgent (deploy/com.school.printer.plist) sets the paths and PATH; the
# values here are the ones you actually have to think about.
#
# chmod 600 this file: it holds the admin bootstrap password.

# ---- Admin bootstrap (first run only) ----
# Set this to a strong password before first start. The server will create
# the admin account on boot, then you can blank this out.
SP_BOOTSTRAP_ADMIN_USER=admin
SP_BOOTSTRAP_ADMIN_PASS=change-me-on-first-boot

# ---- JWT ----
# Leave blank -> auto-generated and stored in data_dir/secret_key
SP_SECRET_KEY=

# ---- CUPS ----
SP_CUPS_QUEUE=bw

# ---- Uploads ----
# Keep in sync with the default in server/app/config.py.
SP_MAX_UPLOAD_MB=50

# ---- Office -> PDF conversion ----
# Word/Excel/PowerPoint uploads are converted locally by driving Office through
# AppleScript. Set to false to refuse them up front instead — e.g. while Office
# is being reinstalled — so students get a clear error rather than a queue of
# jobs that each fail on their own.
SP_OFFICE_CONVERSION_ENABLED=true
# Per-document ceiling in seconds. Past this the GUI app is assumed stuck
# (usually a dialog nobody is there to dismiss) and the job is failed.
SP_OFFICE_CONVERT_TIMEOUT_S=180

# ---- Spool retention ----
# Uploaded files are deleted this many hours after the job reaches a terminal
# state. Without this the spool directory grows without bound. 0 disables the
# reaper.
SP_SPOOL_RETENTION_HOURS=24
