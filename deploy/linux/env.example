# Installed as /opt/school-printer/.env; keep private (0600).
# The installer generates a random bootstrap password on first installation.
SP_BOOTSTRAP_ADMIN_USER=admin
SP_BOOTSTRAP_ADMIN_PASS=
SP_SECRET_KEY=
SP_CUPS_QUEUE=bw
SP_CUPS_SERVER=localhost:631
SP_MAX_UPLOAD_MB=50
SP_OFFICE_BACKEND=libreoffice
SP_OFFICE_CONVERSION_ENABLED=true
SP_OFFICE_CONVERT_TIMEOUT_S=180
SP_SPOOL_RETENTION_HOURS=24
# Reserve the iMac's address in DHCP. Empty uses the registration page's host.
SP_AIRPRINT_HOST=
SP_AIRPRINT_PORT=8631
SP_AIRPRINT_VERIFY=true
SP_AIRPRINT_AUTO_APPROVE_VERIFIED=true
SHIM_RELAY=http://127.0.0.1:8000
SHIM_JOBS_PER_HOUR=30
# Print without a CUPS queue or vendor driver: LPD + PJL straight to the campus
# printer (needs poppler's pdftops or Ghostscript). Default "cups".
# SP_PRINT_BACKEND=lpd
# SP_LPD_HOST=10.2.20.170
# SP_LPD_QUEUE=sjbw
